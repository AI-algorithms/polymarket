# Polymarket API 配置
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_CHAIN_ID=137  # Polygon mainnet

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/polymarket

# 风险管理配置
MAX_POSITION_SIZE=1000  # 单笔最大投注金额（USDC）
KELLY_FRACTION=0.5      # Kelly 公式保守系数（Half-Kelly）
MIN_WIN_RATE=0.90       # 最低胜率要求
MIN_TRADE_COUNT=20      # 用户最少交易次数
MAX_DAILY_LOSS=500      # 单日最大亏损（USDC）

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/polymarket.log
